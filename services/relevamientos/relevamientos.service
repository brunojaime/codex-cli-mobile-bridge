[Unit]
Description=Bridge DEV private meeting intake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/batata/Projects/codex-cli-mobile-bridge
EnvironmentFile=/home/batata/Projects/codex-cli-mobile-bridge/.env
Environment=PYTHONUNBUFFERED=1
Environment=RELEVAMIENTOS_FFMPEG=/home/batata/Projects/codex-cli-mobile-bridge/.data/relevamientos-tools/ffmpeg
ExecStart=/home/batata/Projects/codex-cli-mobile-bridge/.venv/bin/python -m services.relevamientos.cli watch
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/batata/Projects/codex-cli-mobile-bridge/.data/relevamientos /home/batata/.codex
MemoryMax=4G
CPUQuota=150%

[Install]
WantedBy=default.target
