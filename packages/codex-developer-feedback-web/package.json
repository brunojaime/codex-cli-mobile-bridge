{
  "name": "@codex/developer-feedback-web",
  "version": "0.8.0-dev.3",
  "type": "module",
  "description": "Reusable browser feedback for Codex Mobile Bridge",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./core": "./src/core.js",
    "./native": {
      "types": "./src/native.d.ts",
      "import": "./src/native.js"
    },
    "./native-ui": "./src/native-ui.tsx",
    "./server": "./src/server.js"
  },
  "files": [
    "src",
    "README.md",
    "tools"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "test:apps": "node test/apps-browser.mjs"
  },
  "dependencies": {
    "html2canvas": "1.4.1"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.81"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "bin": {
    "codex-feedback": "tools/cli.mjs"
  }
}
