  AWS[AWS Readiness Provider]
  GIT[Git and GitHub]
  WB[Workbench and SDD]
  RESULT[Scaffold Result and Context Pack]
  DOMAIN[Domain Factory and UX Lane]
  ANDROID[Framework-neutral Android Artifact]
  BRIDGE[Bridge Apps and Updater]

  UI --> API
  API --> MODE
  MODE --> RUNNER
  RUNNER --> REGISTRY
  REGISTRY --> MOBILE
  REGISTRY --> WEB
  REGISTRY --> BACKEND
  REGISTRY --> EDGE
  REGISTRY --> AWS
  RUNNER --> GIT
  RUNNER --> WB
  RUNNER --> RESULT
  RESULT -->|explicit Start Product| DOMAIN
  DOMAIN --> MOBILE
  DOMAIN --> WEB
  DOMAIN --> BACKEND
